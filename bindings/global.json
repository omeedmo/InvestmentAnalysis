{
  "tier": "global",
  "note": "Lines essentially every filer reports, bound to consolidated (undimensioned) facts only. A binding with no `dimension` matches the consolidated figure and nothing else, so a segment column can never quietly stand in for a company total.",
  "metrics": [
    {
      "metric": "revenue",
      "label": "Total revenues",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:Revenues"
        }
      ]
    },
    {
      "metric": "costs_and_expenses",
      "label": "Total costs and expenses",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:CostsAndExpenses"
        }
      ]
    },
    {
      "metric": "pretax_income",
      "label": "Earnings before income taxes",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest"
        },
        {
          "element": "us-gaap:IncomeLossFromContinuingOperationsBeforeIncomeTaxesMinorityInterestAndIncomeLossFromEquityMethodInvestments"
        }
      ]
    },
    {
      "metric": "income_tax",
      "label": "Income tax expense",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:IncomeTaxExpenseBenefit"
        }
      ]
    },
    {
      "metric": "net_income",
      "label": "Net earnings attributable to shareholders",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:NetIncomeLoss"
        }
      ]
    },
    {
      "metric": "total_assets",
      "label": "Total assets",
      "section": "Balance sheet",
      "bind": [
        {
          "element": "us-gaap:Assets"
        }
      ]
    },
    {
      "metric": "goodwill",
      "label": "Goodwill",
      "section": "Balance sheet",
      "bind": [
        {
          "element": "us-gaap:Goodwill"
        }
      ]
    },
    {
      "metric": "equity",
      "label": "Total shareholders' equity",
      "section": "Balance sheet",
      "bind": [
        {
          "element": "us-gaap:StockholdersEquity"
        }
      ]
    },
    {
      "metric": "operating_cash_flow",
      "label": "Net cash flows from operating activities",
      "section": "Cash flow",
      "bind": [
        {
          "element": "us-gaap:NetCashProvidedByUsedInOperatingActivities"
        },
        {
          "element": "us-gaap:NetCashProvidedByUsedInOperatingActivitiesContinuingOperations"
        }
      ],
      "note": "Berkshire (and many filers) reported this under the ...ContinuingOperations concept before 2015. Both are listed explicitly; the resolved cell records which one supplied the value."
    },
    {
      "metric": "capex",
      "label": "Purchases of property, plant and equipment",
      "section": "Cash flow",
      "bind": [
        {
          "element": "us-gaap:PaymentsToAcquirePropertyPlantAndEquipment"
        }
      ]
    },
    {
      "metric": "depreciation",
      "label": "Depreciation and amortization",
      "section": "Cash flow",
      "bind": [
        {
          "element": "us-gaap:DepreciationDepletionAndAmortization"
        }
      ]
    },
    {
      "metric": "effective_tax_rate",
      "label": "Effective tax rate",
      "section": "Derived",
      "expr": "income_tax / pretax_income"
    },
    {
      "metric": "cash",
      "label": "Cash & Cash Equivalents",
      "section": "Balance sheet",
      "bind": [
        {
          "element": "us-gaap:CashAndCashEquivalentsAtCarryingValue"
        }
      ]
    },
    {
      "metric": "intangibles",
      "label": "Intangible Assets",
      "section": "Balance sheet",
      "bind": [
        {
          "element": "us-gaap:IntangibleAssetsNetExcludingGoodwill"
        },
        {
          "element": "us-gaap:FiniteLivedIntangibleAssetsNet"
        }
      ]
    },
    {
      "metric": "sga_expense",
      "label": "SG&A Expense",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:SellingGeneralAndAdministrativeExpense"
        },
        {
          "element": "us-gaap:GeneralAndAdministrativeExpense"
        }
      ]
    },
    {
      "metric": "interest_expense",
      "label": "Interest Expense",
      "section": "Income statement",
      "bind": [
        {
          "element": "us-gaap:InterestExpense"
        },
        {
          "element": "us-gaap:InterestExpenseNonoperating"
        }
      ]
    },
    {
      "metric": "stock_based_compensation",
      "label": "Stock-Based Comp (SBC)",
      "section": "Cash flow",
      "bind": [
        {
          "element": "us-gaap:ShareBasedCompensation"
        }
      ]
    },
    {
      "metric": "dividends_paid",
      "label": "Dividends Paid",
      "section": "Cash flow",
      "bind": [
        {
          "element": "us-gaap:PaymentsOfDividendsCommonStock"
        },
        {
          "element": "us-gaap:PaymentsOfDividends"
        }
      ]
    },
    {
      "metric": "buybacks_value",
      "label": "Share Repurchases ($)",
      "section": "Cash flow",
      "bind": [
        {
          "element": "us-gaap:PaymentsForRepurchaseOfCommonStock"
        }
      ]
    },
    {
      "metric": "roe",
      "label": "Return on Equity",
      "section": "Derived",
      "expr": "net_income / equity"
    },
    {
      "metric": "roa",
      "label": "Return on Assets",
      "section": "Derived",
      "expr": "net_income / total_assets"
    },
    {
      "metric": "net_margin",
      "label": "Net Margin",
      "section": "Derived",
      "expr": "net_income / revenue"
    },
    {
      "metric": "fcf",
      "label": "Free Cash Flow",
      "section": "Derived",
      "expr": "operating_cash_flow - capex"
    },
    {
      "metric": "fcf_margin",
      "label": "FCF Margin",
      "section": "Derived",
      "expr": "(operating_cash_flow - capex) / revenue"
    },
    {
      "metric": "adj_fcf",
      "label": "Adj. FCF (FCF \u2212 SBC)",
      "section": "Derived",
      "expr": "operating_cash_flow - capex - stock_based_compensation"
    },
    {
      "metric": "adj_fcf_margin",
      "label": "Adj. FCF Margin",
      "section": "Derived",
      "expr": "(operating_cash_flow - capex - stock_based_compensation) / revenue"
    },
    {
      "metric": "adj_fcf_roe",
      "label": "Adj. FCF ROE",
      "section": "Derived",
      "expr": "(operating_cash_flow - capex - stock_based_compensation) / equity"
    }
  ]
}